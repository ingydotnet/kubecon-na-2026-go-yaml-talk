#!/usr/bin/env bash

set -u

# Presentation startup settings must not reach demo programs or nested Vim.
unset VROOM_START_SLIDE VROOM_WATCH VROOM_WATCH_PERL

file=$1
line_number=$2
line=$(LINE_NUMBER=$line_number perl -ne \
  'if ($. == $ENV{LINE_NUMBER}) { s/\e\[[0-9;]*m//g; print }' "$file")

shopt -s extglob
line=${line##+([[:space:]])}
line=${line#\* }

clear

if [[ $line == https://* ]]; then
  if [[ $OSTYPE == darwin* ]]; then
    open "$line"
  else
    chromium --ozone-platform=x11 \
      --user-data-dir="$HOME/snap/chromium/common/talk-profile" \
      --new-tab "$line" &>/dev/null &
  fi
  exit
fi

if [[ $line != \$\ * && $line != \>\ * ]]; then
  exit
fi

live=false
if [[ $line == \>\ * ]]; then
  live=true
  line=${line#> }
else
  line=${line#\$ }
fi

if [[ $line == vim\ * ]]; then
  line=${line#vim }
  # Vroom examples intentionally use simple space-separated file names.
  read -ra files <<<"$line"
  vim --not-a-term -S vimrc2 +1 "${files[@]}"
  exit
fi

run_command() {
  if [[ $line == *in-1* ]]; then
    # shellcheck disable=SC1090
    source <(in-1 --rc)
    eval "$line"
  else
    bash -c "$line"
  fi
}

echo
echo

if $live; then
  printf '+%s\n' "$line"
  run_command </dev/tty
  printf '\nE\r'
  read -r < /dev/tty
  exit
fi

text=$(run_command </dev/tty 2>&1)
text=$(printf '+%s\n%s' "$line" "$text")
lines=$(perl -ne 'END { print $. }' <<<"$text")
terminal_lines=$(tput lines)

if ((lines >= terminal_lines)); then
  printf '%s\n' "$text" | less
else
  printf '%s\n' "$text"
  printf '\nE\r'
  read -r < /dev/tty
fi
